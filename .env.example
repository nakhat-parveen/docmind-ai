# Copy to .env and adjust. docker compose picks it up automatically.

# Comma separated list of accepted API keys
DOCMIND_API_KEYS=change-me

# "ollama" (local models) or "openai"
SPRING_PROFILES_ACTIVE=ollama

# Only needed for the openai profile
OPENAI_API_KEY=

# Ollama models, pulled automatically on first start
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
